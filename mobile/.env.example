# Where the trading server lives. Copy to .env.local and edit.
#
# Leave both unset to use the production server
# (https://wintratrade.online/api and wss://wintratrade.online/ws).
#
# Local server + Android emulator (after `adb reverse tcp:4000 tcp:4000`):
#   EXPO_PUBLIC_API_URL=http://localhost:4000
# Local server + phone on the same Wi-Fi:
#   EXPO_PUBLIC_API_URL=http://<your PC's LAN IP>:4000
EXPO_PUBLIC_API_URL=
# Defaults to the API URL with ws(s):// and /ws appended.
EXPO_PUBLIC_WS_URL=
