{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wintratrade.online/api",
        "EXPO_PUBLIC_WS_URL": "wss://wintratrade.online/ws"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wintratrade.online/api",
        "EXPO_PUBLIC_WS_URL": "wss://wintratrade.online/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
