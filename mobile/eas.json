{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://binary-trading-api-ih4v.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://binary-trading-api-ih4v.onrender.com/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://binary-trading-api-ih4v.onrender.com",
        "EXPO_PUBLIC_WS_URL": "wss://binary-trading-api-ih4v.onrender.com/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
