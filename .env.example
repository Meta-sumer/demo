# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Datastores
# Host port for the dockerised MongoDB. Change it if 27017 is already in use.
# ---------------------------------------------------------------------------
MONGO_PORT=27017
MONGO_URI=mongodb://127.0.0.1:27017/binary_trading?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
# Multi-document transactions require a replica set. Set to false only for a
# standalone mongod (settlement then falls back to guarded atomic updates).
ENABLE_MONGO_TRANSACTIONS=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Proxies whose X-Forwarded-For / X-Real-IP is believed (CIDR list). Anyone
# else's header is ignored. Default: loopback only. Behind Nginx with the API
# in Docker (docker-compose.prod.yml) the peer is Docker's bridge gateway, so
# production uses 172.16.0.0/12 - set there already.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Admin accounts must use an authenticator code at sign-in. An admin without
# one is asked to set it up at the next sign-in. Customers are not affected.
ADMIN_2FA_REQUIRED=true
ADMIN_2FA_ISSUER=Binary Trading Admin
# Encrypts stored authenticator secrets (32+ characters). Empty derives a key
# from JWT_SECRET; set a separate one in production and never change it, or
# every admin has to set up two-factor again.
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Market data provider
#   simulated  -> local random-walk generator (development / testing only)
#   binance    -> real public Binance websocket feed (crypto, no key required)
#   generic-ws -> a JSON websocket feed described by MARKET_DATA_WS_URL
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_WS_URL=
# Allows the simulated provider to run with NODE_ENV=production. Keep false.
ALLOW_SIMULATED_FEED_IN_PRODUCTION=false

# Feed health thresholds (milliseconds) — configurable, see §6 of the spec
FEED_HEALTHY_MAX_MS=100
FEED_DEGRADED_MAX_MS=300
FEED_STALE_MAX_MS=1000
# A tick older than this means the asset has no usable price at all
FEED_TICK_MAX_AGE_MS=5000

# ---------------------------------------------------------------------------
# Hedge execution provider
#   paper  -> internal sandbox execution (default, no external orders)
#   broker -> external broker adapter (requires credentials below)
#   lp     -> liquidity provider adapter (requires credentials below)
# ---------------------------------------------------------------------------
HEDGE_PROVIDER=paper
HEDGE_API_KEY=
HEDGE_API_SECRET=
HEDGE_API_URL=
# Live external execution is refused unless this is explicitly true.
HEDGE_LIVE_EXECUTION_ENABLED=false

# ---------------------------------------------------------------------------
# Workers (set false on API-only replicas; leader election is done in Redis)
# ---------------------------------------------------------------------------
WORKERS_ENABLED=true
EXPIRY_TICK_MS=100
SETTLEMENT_BATCH_SIZE=200
RISK_INTERVAL_MS=1000
HEDGE_INTERVAL_MS=1000
RECONCILIATION_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Frontends / CORS
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Manual deposit / withdrawal proof uploads
#   Payment screenshots are served only through an authenticated route, never
#   from a public static mount.
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=262144
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_TOTAL=10000

# ---------------------------------------------------------------------------
# Seed bootstrap (used by `npm run seed`)
# ---------------------------------------------------------------------------
# Passwords for the seeded accounts. Leave one empty and the seed generates a
# random password and prints it once. Never commit real passwords.
SEED_SUPER_ADMIN_EMAIL=admin@binary.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_RISK_PASSWORD=
SEED_FINANCE_PASSWORD=
SEED_TRADER_PASSWORD=
