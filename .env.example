# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Datastores
# Host port for the dockerised MongoDB. Change it if 27017 is already in use.
# ---------------------------------------------------------------------------
MONGO_PORT=27017
MONGO_URI=mongodb://127.0.0.1:27017/binary_trading?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
# Multi-document transactions require a replica set. Set to false only for a
# standalone mongod (settlement then falls back to guarded atomic updates).
ENABLE_MONGO_TRANSACTIONS=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Proxies whose X-Forwarded-For / X-Real-IP is believed (CIDR list). Anyone
# else's header is ignored. Default: loopback only. Behind Nginx with the API
# in Docker (docker-compose.prod.yml) the peer is Docker's bridge gateway, so
# production uses 172.16.0.0/12 - set there already.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Admin accounts must use an authenticator code at sign-in. An admin without
# one is asked to set it up at the next sign-in. Customers are not affected.
ADMIN_2FA_REQUIRED=true
ADMIN_2FA_ISSUER=Binary Trading Admin
# Encrypts stored authenticator secrets (32+ characters). Empty derives a key
# from JWT_SECRET; set a separate one in production and never change it, or
# every admin has to set up two-factor again.
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Market data provider
#   simulated  -> local random-walk generator (development / testing only)
#   binance    -> real public Binance websocket feed (crypto, no key required)
#   generic-ws -> a JSON websocket feed described by MARKET_DATA_WS_URL
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_WS_URL=
# Allows the simulated provider to run with NODE_ENV=production. Keep false.
ALLOW_SIMULATED_FEED_IN_PRODUCTION=false
# Launch scope: switch off at boot the assets that are not priced at launch
# (EUR/USD, GBP/USD, XAU/USD). Idempotent and audited; production sets true
# (docs/audit/operations/feed-rules.md section 9.1).
APPLY_LAUNCH_SCOPE=false

# Feed health thresholds (milliseconds). These only seed version 1 of the risk
# configuration on a fresh database; from then on the admin console (Settings,
# PUT /admin/settings/risk) is the one authority and these values are ignored.
# The gap, drop, clock-sync and tick-history rules are risk configuration only
# (docs/audit/operations/feed-rules.md). FEED_STALE_MAX_MS is retired (never read).
FEED_HEALTHY_MAX_MS=100
FEED_DEGRADED_MAX_MS=300
# A tick older than this means the asset has no usable price at all
FEED_TICK_MAX_AGE_MS=5000

# ---------------------------------------------------------------------------
# Hedging - Binance USDⓈ-M perpetual futures (docs/audit/hedging/hedging-spec.md)
#   paper   -> in-process simulated venue (default, no external orders)
#   binance -> Binance USDⓈ-M futures REST, HMAC-SHA256 signed requests
# Only the assets in HEDGE_SYMBOLS can ever be hedged (BTC/USD, ETH/USD at
# launch; EUR/USD, GBP/USD and XAU/USD are never hedged).
# ---------------------------------------------------------------------------
HEDGE_PROVIDER=paper
# testnet -> https://testnet.binancefuture.com (fake money)
# live    -> https://fapi.binance.com (real money; needs the switch below)
HEDGE_BINANCE_ENV=testnet
# Futures API key and secret of the hedge sub-account. Never commit them.
HEDGE_API_KEY=
HEDGE_API_SECRET=
# Optional base URL override (default: the URL of HEDGE_BINANCE_ENV).
HEDGE_API_URL=
# Orders reach the LIVE exchange only when this is true (and the keys are set).
HEDGE_LIVE_EXECUTION_ENABLED=false
HEDGE_SYMBOLS=BTC/USD=BTCUSDT,ETH/USD=ETHUSDT
# INR per USDT used to size hedges and convert hedge P&L, with the time it was
# observed (RFC 3339). An admin can set a newer rate on the Hedging page. Older
# than HEDGE_FX_MAX_AGE_MS -> hedging is unavailable (no guessing).
HEDGE_INR_PER_USDT=
HEDGE_INR_PER_USDT_AS_OF=
HEDGE_FX_MAX_AGE_MS=86400000
# Cost model, basis points of notional per side. The account's real taker
# fee replaces HEDGE_TAKER_FEE_BPS when the venue reports it.
HEDGE_TAKER_FEE_BPS=5
HEDGE_SLIPPAGE_BPS=2
HEDGE_FALLBACK_SPREAD_BPS=1
# Round-trip cost above this -> "hedging expensive" (pricing widens/refuses).
HEDGE_MAX_COST_BPS=30
# The hedge never exceeds this multiple of the asset's expiry liability.
HEDGE_MAX_LIABILITY_MULTIPLE=100
# Largest single order, USDT notional (bigger targets are worked in clips).
HEDGE_MAX_ORDER_USDT=50000
# Position and funding reconciliation against the venue.
HEDGE_RECONCILE_INTERVAL_MS=60000
HEDGE_RECV_WINDOW_MS=5000
HEDGE_REQUEST_TIMEOUT_MS=10000
# A venue snapshot (book, mark, funding) older than this = venue unavailable.
HEDGE_VENUE_MAX_AGE_MS=15000

# ---------------------------------------------------------------------------
# Workers (set false on API-only replicas; leader election is done in Redis)
# ---------------------------------------------------------------------------
WORKERS_ENABLED=true
EXPIRY_TICK_MS=100
SETTLEMENT_BATCH_SIZE=200
RISK_INTERVAL_MS=1000
HEDGE_INTERVAL_MS=1000
RECONCILIATION_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Frontends / CORS
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Manual deposit / withdrawal proof uploads
#   Payment screenshots are served only through an authenticated route, never
#   from a public static mount.
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=262144
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_TOTAL=10000

# ---------------------------------------------------------------------------
# USDT wallet (BeeX Payments) - see docs/audit/usdt/usdt-flows.md
#   Amounts are integer micro-USDT (1 USDT = 1000000). Networks: USDTTRC20,
#   USDTBSC. The webhook URL to register at BeeX is
#   https://<your domain>/webhooks/beex/crypto
# ---------------------------------------------------------------------------
# Master switch. Off: the wallet answers USDT_DISABLED and no USDT worker runs.
USDT_ENABLED=false
#   beex -> the real gateway (needs BEEX_API_KEY and BEEX_WEBHOOK_SECRET)
#   mock -> in-memory sandbox for development and tests (no keys, no network)
BEEX_PROVIDER=mock
BEEX_API_BASE_URL=https://beexpayments.com/api/v1
# ck_live_... moves real money; ck_test_... is BeeX's sandbox. Never commit one.
BEEX_API_KEY=
# HMAC secret BeeX signs webhooks with (at least 16 characters).
BEEX_WEBHOOK_SECRET=
# Credit test-mode payments (development, or the production sandbox below).
BEEX_ACCEPT_TEST_MODE=false
BEEX_PAY_URL_BASE=https://beexpayments.com/pay/
# Where BeeX sends the customer back (default: CLIENT_URL + /wallet/usdt/success
# and CLIENT_URL + /wallet/usdt).
USDT_SUCCESS_URL=
USDT_CANCEL_URL=
# received -> credit what the customer sent; net -> credit it after BeeX's fee.
USDT_DEPOSIT_CREDIT_BASIS=received
# Withdrawals above this many micro-USDT wait for an operator; 0 = every one.
USDT_WITHDRAWAL_REVIEW_ABOVE=0
# Per-customer rolling 24 h withdrawal limit in micro-USDT; 0 = BeeX's cap.
USDT_USER_DAILY_WITHDRAWAL_LIMIT=0
# USDT trading is a separate decision: keep false.
USDT_TRANSFER_TO_TRADING_ENABLED=false
# NODE_ENV=production refuses the mock, ck_test_ keys and test-mode credits
# unless this is true: the deliberate switch to run the sandbox in production
# until live keys exist. Remove it (and set a ck_live_ key) to go live.
ALLOW_BEEX_SANDBOX_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Alert email (server-go/internal/service/alerts; also used by the VPS host
# scripts deploy/vps/monitor.sh and backup-mongo.sh)
#   Off by default. When true the server refuses to boot unless SMTP_HOST,
#   ALERT_EMAIL_FROM and ALERT_EMAIL_TO are set. Port 465 = implicit TLS; any
#   other port must offer STARTTLS, which is always used (never clear text).
#   Alerts are stored and shown in the admin console (Governance > Alerts)
#   whether or not email is on.
# ---------------------------------------------------------------------------
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# Both or neither. Never commit them.
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Comma-separated list of recipients.
ALERT_EMAIL_TO=
# Lowest severity emailed: info | warning | critical.
ALERT_MIN_SEVERITY=warning
ALERT_EMAIL_SUBJECT_PREFIX=[wintratrade]
# At most this many emails per rolling hour (a digest counts once).
ALERT_EMAIL_MAX_PER_HOUR=20
# How long a condition must last before it alerts.
ALERT_FEED_STALE_SECONDS=60
ALERT_BOOK_UNAVAILABLE_SECONDS=30
ALERT_RATE_LIMITER_SECONDS=60
ALERT_SETTLEMENT_STUCK_MINUTES=10

# ---------------------------------------------------------------------------
# Datastore credentials (production, docker-compose.prod.yml)
#   Generated once on the VPS by deploy/vps/first-setup.sh or deploy.sh (hex,
#   never printed); the compose file builds MONGO_URI and REDIS_URL from
#   them, so MONGO_URI / REDIS_URL above are for local development only.
#   Local development (docker-compose.yml) runs without auth: leave empty.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=wintratrade
MONGO_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Seed bootstrap (used by `npm run seed`)
# ---------------------------------------------------------------------------
# Passwords for the seeded accounts. Leave one empty and the seed generates a
# random password and prints it once. Never commit real passwords.
SEED_SUPER_ADMIN_EMAIL=admin@binary.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_RISK_PASSWORD=
SEED_FINANCE_PASSWORD=
SEED_TRADER_PASSWORD=
